{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPenViewer",
  "version": "0.1.0",
  "identifier": "com.tank4444.openpenviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPenViewer",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pen"],
        "name": "Pencil Design File",
        "description": "Pencil.dev .pen design file",
        "role": "Editor"
      }
    ]
  }
}

